- content_for :page_title do
  = t('admin.settings.appearance.title')

- content_for :heading do
  %h1= t('admin.settings.title')
  = render partial: 'admin/settings/shared/links'

= simple_form_for @admin_settings, url: admin_settings_appearance_path do |f|
  = render 'shared/error_messages', object: @admin_settings

  %p.lead= t('admin.settings.appearance.preamble')

  .fields-group
    = f.input :theme,
              collection: Themes.instance.names,
              include_blank: false,
              label_method: ->(theme) { I18n.t("themes.#{theme}", default: theme) },
              wrapper: :with_label

  .fields-group
    = f.input :custom_css,
              as: :text,
              input_html: { rows: 8 },
              wrapper: :with_block_label

  %h4= t('admin.settings.appearance.theme_branding', default: 'Theme branding')
  %p.lead= t('admin.settings.appearance.theme_branding_hint', default: 'Pick a few brand colors and upload a background image. Leave a color blank to keep the default. Changes apply live with no downtime.')

  .fields-row
    = render 'theme_color_field', f: f, attribute: :theme_color_brand, placeholder: '#6364ff'
    = render 'theme_color_field', f: f, attribute: :theme_color_text, placeholder: '#f6f6f9'

  .fields-row
    = render 'theme_color_field', f: f, attribute: :theme_color_background, placeholder: '#181820'
    = render 'theme_color_field', f: f, attribute: :theme_color_background_secondary, placeholder: '#21212c'

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :hero,
                as: :file,
                wrapper: :with_block_label

    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.hero.persisted?
        = image_tag @admin_settings.hero.file.url, class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.hero), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :wordmark_dark,
                as: :file,
                wrapper: :with_block_label

    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.wordmark_dark.persisted?
        = image_tag @admin_settings.wordmark_dark.file.url, class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.wordmark_dark), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :wordmark_light,
                as: :file,
                wrapper: :with_block_label

    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.wordmark_light.persisted?
        = image_tag @admin_settings.wordmark_light.file.url, class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.wordmark_light), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :mascot,
                as: :file,
                wrapper: :with_block_label

    .fields-row__column.fields-row__column-6.fields-group
      - if @admin_settings.mascot.persisted?
        = image_tag @admin_settings.mascot.file.url, class: 'fields-group__thumbnail'
        = link_to admin_site_upload_path(@admin_settings.mascot), data: { method: :delete }, class: 'link-button link-button--destructive' do
          = material_symbol 'delete'
          = t('admin.site_uploads.delete')

  .actions
    %button#theme-preview-button.button.button-tertiary{ type: 'button', data: { preview_url: preview_admin_settings_appearance_path } }
      = t('admin.settings.appearance.preview', default: 'Preview')
    = f.button :button, t('generic.save_changes'), type: :submit
